<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - City Care Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark bg-primary clinic-navbar">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Appointments" asp-action="Index">City Care Clinic</a>
            <span class="navbar-text text-white-50 small">Secretary desk</span>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3">
        City Care Clinic &middot; Appointment booking
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
